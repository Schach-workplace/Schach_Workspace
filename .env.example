# Reference LOCAL Compose configuration. Replace every placeholder before starting.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
BOOTSTRAP_EMAIL=founder@example.com
BOOTSTRAP_NAME=Company Founder
BOOTSTRAP_PASSWORD=replace-with-a-unique-founder-password
ENVIRONMENT=development
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://127.0.0.1:8080
SESSION_HOURS=72
# Production: HTTPS origin, secure cookies, ENVIRONMENT=production, least-privilege DB role.

# Communication: scanner and media volume are provided by Compose.
# Generate a private 32-byte hex key; back it up in the secret manager.
MFA_ENCRYPTION_KEY=
# Enable calls only with a private self-hosted provider. Never expose 7880.
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
COMMUNICATION_MEDIA_LIMIT_BYTES=26214400
COMMUNICATION_USER_QUOTA_BYTES=524288000
COMMUNICATION_COMPANY_QUOTA_BYTES=26843545600
COMMUNICATION_UNUSED_UPLOAD_HOURS=24
COMMUNICATION_MEDIA_RETENTION_DAYS=90
COMMUNICATION_MESSAGE_RETENTION_DAYS=365
