{
  "expo": {
    "name": "Schach Workspace",
    "slug": "schach-workspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.schach.workspace",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Send voice notes and join company calls.",
        "NSCameraUsageDescription": "Capture task evidence and expense receipts, share chat photos and join company video calls.",
        "UIBackgroundModes": ["audio", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.schach.workspace",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "schach-updates"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Capture task evidence and expense receipts, share chat photos and join company video calls.",
          "microphonePermission": "Send voice notes and join company calls."
        }
      ],
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      "expo-asset",
      "./plugins/withCallService",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Capture task evidence and expense receipts, share chat photos and join company video calls.",
          "photosPermission": "Choose a photo explicitly for company chat, task evidence or expense receipts.",
          "microphonePermission": "Send voice notes and join company calls."
        }
      ]
    ],
    "scheme": "schach"
  }
}
